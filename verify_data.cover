                       if not has_valid_aliases:
                           issues.append(f"invalid aliases ({aliases!r})")
                       violations.append(f"[{game}] '{item_name}': " + ", ".join(issues))
                       
    7:         game_summaries[game] = {
    7:             "total": g_total,
