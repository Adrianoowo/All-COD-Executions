  699:             has_valid_name = isinstance(name, str) and len(name.strip()) > 0
  699:             has_valid_icon = isinstance(icon, str) and len(icon.strip()) > 0
  699:             has_valid_standing = isinstance(standing, str) and len(standing.strip()) > 0
  699:             has_valid_prone = isinstance(prone, str) and len(prone.strip()) > 0
  699:             has_valid_downed = isinstance(downed, str) and len(downed.strip()) > 0
  699:             has_valid_bundle = isinstance(bundle, str) and len(bundle.strip()) > 0
  699:             has_valid_price = isinstance(price, (int, float)) and not isinstance(price, bool) and price >= 0
  699:             has_valid_aliases = isinstance(aliases, list)
                   
  699:             is_compliant = (
 4893:                 has_valid_name and
